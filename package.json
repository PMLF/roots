{
  "name": "raizes",
  "version": "0.1.0",
  "private": true,
  "description": "Raízes — jogo de browser de gestão de futebol português ligado às cidades",
  "scripts": {
    "dev": "pnpm sqlite:copiar && next dev",
    "build": "pnpm sqlite:copiar && next build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.engine.json && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint .",
    "test": "vitest run",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "sqlite:copiar": "node tools/copiar-sqlite-wasm.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "better-sqlite3": "^13.0.3",
    "intl-messageformat": "12.1.3",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@10.28.0"
}
